# Leave empty to use the same-origin /api proxy provided by Vite or Nginx.
VITE_API_BASE_URL=
# Set to demo only to bypass the backend and read bundled historical JSON.
VITE_DATA_MODE=api

# Optional: enable Yandex Maps Tiles API. Use a Tiles API key, not a JS API key.
# Leave empty to use OpenStreetMap. The official Yandex logo and attribution
# are shown automatically when this provider is active.
VITE_YANDEX_TILES_API_KEY=
# map | future_map | driving | transit | admin
VITE_YANDEX_MAP_STYLE=map

# Optional OpenStreetMap-compatible backup provider.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
